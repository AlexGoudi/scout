{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sonic-net/scout/schemas/scout-brief-1.0.json",
  "title": "SONiC Scout risk brief",
  "description": "The contract between the deterministic static stage and the agent stage (HLD section 4.4). Stage 1 validates on write, stage 2 on read. Every block here is either a fact the static stage established or a question it refused to guess at.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "brief", "hotspots", "entities", "coverage", "rules", "questions", "unresolved", "entity_closure", "budget"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "brief": {"$ref": "#/$defs/run"},
    "hotspots": {"type": "array", "items": {"$ref": "#/$defs/hotspot"}},
    "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "coverage": {"$ref": "#/$defs/coverage"},
    "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
    "questions": {"type": "array", "items": {"$ref": "#/$defs/question"}},
    "unresolved": {"type": "array", "items": {"$ref": "#/$defs/unresolved"}},
    "entity_closure": {
      "type": "boolean",
      "description": "When true, a finding naming an entity absent from `entities` is dropped before the citation resolver runs. Enforced mechanically, not by prompt."
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tool_calls", "max_blob_reads", "max_input_tokens"],
      "properties": {
        "max_tool_calls": {"type": "integer", "minimum": 0},
        "max_blob_reads": {"type": "integer", "minimum": 0},
        "max_input_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "paths_to_assess": {"$ref": "#/$defs/paths_to_assess"}
  },
  "$defs": {
    "paths_to_assess": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional. The feature groups of scout_impl/static/datapath.json the change touches, and the other paths in those groups, per repository. Omitted when the change touches no group. Advisory context for a reviewer; not an input to stage 2.",
      "required": ["repo", "rule", "features", "repos"],
      "properties": {
        "repo": {"type": "string", "minLength": 1, "description": "The feature-map repository the changed paths are relative to."},
        "rule": {
          "enum": ["shared", "union"],
          "description": "`shared`: the groups every matched changed path is in. `union`: they share none, so every group any of them is in."
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "changed"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "changed": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "repos": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repo", "paths"],
            "properties": {
              "repo": {"type": "string", "minLength": 1},
              "paths": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repo", "adapter", "mode", "base_sha", "head_sha", "tree_paths", "measured_at", "static_duration_s", "blobs_read", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "repo": {"type": "string", "minLength": 1},
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "rule_pack_sha"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1},
            "rule_pack_sha": {"type": "string", "minLength": 1}
          }
        },
        "mode": {"enum": ["pr", "range", "sync", "replay", "tree"]},
        "base_sha": {"type": "string"},
        "head_sha": {"type": "string", "minLength": 1},
        "tree_paths": {"type": "integer", "minimum": 0},
        "measured_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "static_duration_s": {"type": "number", "minimum": 0},
        "blobs_read": {
          "type": "integer",
          "minimum": 0,
          "description": "Round trips actually spent. Reported so NFR-12 is measurable rather than aspirational."
        },
        "blob_cache_hits": {"type": "integer", "minimum": 0},
        "status": {"enum": ["complete", "partial", "degraded"]}
      }
    },
    "hotspot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "path_class", "change_kind", "score", "score_breakdown", "entities"],
      "properties": {
        "id": {"type": "string", "pattern": "^h-[0-9]{3}$"},
        "path": {"type": "string", "minLength": 1},
        "path_class": {"type": "string", "minLength": 1},
        "change_kind": {"enum": ["added", "deleted", "modified", "renamed", "copied"]},
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "score_breakdown": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path_class", "entity_fanout", "coverage_gap", "ambiguity"],
          "description": "Components sum to `score`. A ranking nobody can audit is a ranking nobody trusts.",
          "properties": {
            "path_class": {"type": "number", "minimum": 0},
            "entity_fanout": {"type": "number", "minimum": 0},
            "coverage_gap": {"type": "number", "minimum": 0},
            "ambiguity": {"type": "number", "minimum": 0}
          }
        },
        "entities": {"type": "array", "items": {"$ref": "#/$defs/entity_id"}}
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "members", "resolved_via", "source"],
      "properties": {
        "id": {"$ref": "#/$defs/entity_id"},
        "kind": {"enum": ["platform", "hwsku", "vendor", "asic_family", "ci_job_group", "topology", "topology_type"]},
        "members": {
          "type": "integer",
          "minimum": 0,
          "description": "How many of the tree's primary entities this one accounts for: 1 for a platform or topology, the number declaring it for a family, the number it owns for a vendor, the number it builds by name for a job group."
        },
        "resolved_via": {"enum": ["tree", "blob", "symlink"]},
        "source": {"type": "string", "minLength": 1},
        "arch": {"type": "string"},
        "family": {
          "type": "string",
          "description": "For a job group, the ASIC family its PLATFORM_NAME builds, which differs from the group name when the group is architecture-qualified."
        }
      }
    },
    "entity_id": {"type": "string", "pattern": "^[a-z_]+:.+$"},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "job_groups", "job_group_names", "parse", "declarations_in_tree", "platforms_in_tree", "excluded_as_non_platform", "kept_without_hwsku", "affected", "covered", "uncovered", "ambiguous"],
      "description": "The four sets are exhaustive and disjoint over `affected`.",
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "job_groups": {"type": "integer", "minimum": 0},
        "job_group_names": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "parse": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "strict", "loose_scan_agrees"],
          "description": "The parse is published, not just its result. `loose_scan_agrees: false` is a test failure, not a warning (HLD section 6.2.2).",
          "properties": {
            "scope": {"type": "string", "minLength": 1},
            "strict": {"type": "boolean"},
            "loose_scan_agrees": {"type": "boolean"},
            "loose_scan_names": {"type": "array", "items": {"type": "string"}},
            "templates_read": {"type": "array", "items": {"type": "string"}},
            "limitations": {"type": "array", "items": {"type": "string"}}
          }
        },
        "declarations_in_tree": {"type": "integer", "minimum": 0},
        "platforms_in_tree": {"type": "integer", "minimum": 0},
        "excluded_as_non_platform": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "aliased_platforms": {
          "type": "integer",
          "minimum": 0,
          "description": "Rule C6: entity directories that are themselves git symlinks to another one. Each is a distinct ONIE platform running its target's data, and carries no declaration of its own — which is why `declarations_in_tree` and `platforms_in_tree` are different quantities even where they happen to be equal."
        },
        "aliased_as_platform": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "kept_without_hwsku": {"type": "integer", "minimum": 0},
        "symlinked_declarations": {"type": "integer", "minimum": 0},
        "unresolved_declarations": {"type": "integer", "minimum": 0},
        "multi_family_declarations": {"type": "integer", "minimum": 0},
        "affected": {"type": "array", "items": {"$ref": "#/$defs/entity_id"}},
        "covered": {"type": "array", "items": {"$ref": "#/$defs/entity_id"}},
        "uncovered": {"type": "array", "items": {"$ref": "#/$defs/entity_id"}},
        "ambiguous": {"type": "array", "items": {"$ref": "#/$defs/entity_id"}}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "derivation", "citations"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "derivation": {
          "enum": ["static", "agent", "convention"],
          "description": "`static` is deterministic from the tree. `convention` is a naming convention the tree follows but does not declare, which is weaker and is marked so that a finding resting on one can be banded below a finding resting on a fact. `agent` is an adjudication."
        },
        "citations": {
          "type": "array",
          "minItems": 1,
          "description": "Every rule carries a citation into the tree. A rule with none is a bug in the adapter.",
          "items": {"$ref": "#/$defs/citation"}
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line_start", "line_end", "rev", "role"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "line_start": {"type": "integer", "minimum": 0},
        "line_end": {"type": "integer", "minimum": 0},
        "rev": {"type": "string", "minLength": 1},
        "role": {"enum": ["cause", "affected", "precedent", "contract"]},
        "quote": {"type": "string"}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rule", "entities", "ask", "required_evidence", "prior", "budget"],
      "properties": {
        "id": {"type": "string", "pattern": "^q-[0-9]{3}$"},
        "rule": {"type": "string", "minLength": 1},
        "entities": {"type": "array", "items": {"$ref": "#/$defs/entity_id"}},
        "ask": {"type": "string", "minLength": 1},
        "required_evidence": {"type": "array", "minItems": 1, "items": {"enum": ["cause", "affected", "precedent", "contract"]}},
        "prior": {"type": "number", "minimum": 0, "maximum": 1},
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool_calls", "blob_reads"],
          "properties": {
            "tool_calls": {"type": "integer", "minimum": 0},
            "blob_reads": {"type": "integer", "minimum": 0}
          }
        },
        "kind": {
          "enum": ["ambiguity", "materiality"],
          "description": "What the agent is asked to do: adjudicate an unresolved item per entity, or judge whether the change materially reaches entities PR CI never builds. Stage 2 dispatches on this rather than on the question id."
        },
        "unresolved": {"type": "string", "pattern": "^u-[0-9]{3}$"}
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "summary", "candidates", "entities", "adjudicated_by"],
      "description": "Under-determined facts with their candidate answers and the rule under which each holds. Never silently resolved by stage 1.",
      "properties": {
        "id": {"type": "string", "pattern": "^u-[0-9]{3}$"},
        "kind": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "candidates": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule", "uncovered"],
            "properties": {
              "rule": {"type": "string", "minLength": 1},
              "uncovered": {"type": "integer", "minimum": 0}
            }
          }
        },
        "entities": {"type": "array", "items": {"$ref": "#/$defs/entity_id"}},
        "adjudicated_by": {"enum": ["agent", "human"]},
        "rule_candidate": {"$ref": "#/$defs/rule_candidate"}
      }
    },
    "rule_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules", "derivation", "statement", "uncovered", "platforms"],
      "description": "The answer the stated rules imply for each entity of an unresolved item. An inference, never a resolution: the entities stay in `coverage.ambiguous`, and stage 2 compares the agent's answer with this one and marks a disagreement contested rather than letting either win.",
      "properties": {
        "rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "candidate": {
          "type": "string",
          "minLength": 1,
          "description": "Which entry of the sibling `candidates` list this breakdown is the working of. Their totals are one computation, and the brief builder rejects a brief where they differ."
        },
        "derivation": {"const": "naming-convention-inference"},
        "statement": {"type": "string", "minLength": 1},
        "uncovered": {"type": "integer", "minimum": 0},
        "platforms": {"type": "array", "items": {"$ref": "#/$defs/platform_candidate"}}
      }
    },
    "platform_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity", "arch", "families", "resolution", "job_groups"],
      "properties": {
        "entity": {"$ref": "#/$defs/entity_id"},
        "arch": {"type": "string", "minLength": 1},
        "families": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "resolution": {"enum": ["covered", "uncovered", "undetermined"]},
        "job_groups": {"type": "array", "items": {"$ref": "#/$defs/entity_id"}}
      }
    }
  }
}
