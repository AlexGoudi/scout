# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Run outputs, written into whichever directory the CLI is invoked from.
/scout-brief*.json
/scout-report*.json
/scout-run*.jsonl
/scout-corpus*.jsonl
/scout-score-pr*.json
/changeset.json
/sync.json

# Commit datasets and trained risk models; both are rebuilt from a clone and a snapshot sha.
/corpus/*/
/models/

# The dataset build's record and blame cache (`dataset build --cache`). Keyed by git object
# SHA, so it is rebuildable from the clone and never belongs in history.
/.scout-cache/
.env

# A virtualenv created in the repository root itself, or as `scout/`.
/scout/
/lib/
/lib64/
/bin/
/pyvenv.cfg
