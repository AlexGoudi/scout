# Scout Python lint and format
#
# Primary config: pyproject.toml
#   [tool.ruff] / [tool.ruff.format]  —  ruff check .   and   ruff format .
#   [tool.flake8]                     —  flake8 with flake8-pyproject, or [flake8] below
#
# This file mirrors [tool.flake8] for `python3 -m flake8` without extra plugins.
# E203 conflicts with `ruff format` slice spacing.

[flake8]
max-line-length = 120
extend-ignore = E203
extend-exclude = .scout-cache,.venv,venv,corpus,models,mined-data,.ruff_cache
per-file-ignores =
    scout_impl/repos/sonic_mgmt_calibration.py:E501
    scout_impl/repos/sonic_buildimage_calibration.py:E501
    scout_impl/eval/join_labels.py:E501
